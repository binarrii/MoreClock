{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "moreclock-website",
  "account_id": "011e57b1f4b1a54fe85a125f3aa94cab",
  "compatibility_date": "2026-11-17",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "moreclock.skyviiew.com", "custom_domain": true }
  ]
}
