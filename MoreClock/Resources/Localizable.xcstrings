    "Language changes take effect after relaunch.": {
      "comment": "General language control: changes the app language using the native macOS per-app preference. Relaunch means reopen this app, not restart the Mac.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新打开应用后，语言更改才会生效。"
