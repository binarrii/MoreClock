    "No clock is shown in the menu bar. Open MoreClock again from Finder or Spotlight to get back to Settings.": {
      "comment": "Settings footer warning.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "菜单栏中未显示任何时钟。请从访达或聚焦再次打开 MoreClock 以返回设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選單列中沒有顯示任何時鐘。請從 Finder 或 Spotlight 再次打開 MoreClock 以返回設定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーに時計が表示されていません。設定に戻るには、FinderまたはSpotlightからMoreClockをもう一度開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대에 표시된 시계가 없습니다. 설정으로 돌아가려면 Finder 또는 Spotlight에서 MoreClock을 다시 여세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der Menüleiste wird keine Uhr angezeigt. Öffne MoreClock erneut über den Finder oder Spotlight, um zu den Einstellungen zurückzukehren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune horloge n’est affichée dans la barre des menus. Rouvrez MoreClock depuis le Finder ou Spotlight pour revenir aux réglages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se muestra ningún reloj en la barra de menús. Vuelve a abrir MoreClock desde el Finder o Spotlight para volver a Ajustes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun orologio è visibile nella barra dei menu. Apri di nuovo MoreClock dal Finder o da Spotlight per tornare a Impostazioni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum relógio aparece na barra de menus. Abra o MoreClock novamente pelo Finder ou pelo Spotlight para voltar aos Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В строке меню нет ни одних часов. Снова откройте MoreClock из Finder или Spotlight, чтобы вернуться к настройкам."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تظهر أي ساعة في شريط القائمة. افتح MoreClock مرة أخرى من Finder أو Spotlight للعودة إلى الإعدادات."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هیچ ساعتی در نوار منو نمایش داده نمی‌شود. برای بازگشت به تنظیمات، MoreClock را دوباره از Finder یا Spotlight باز کنید."
          }
        }
      }
    },
