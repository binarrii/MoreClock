    "%@ ahead of local time": {
      "comment": "Disabled info line in a clock's menu bar menu. %@ is an already-localized duration such as \"8 hr\" or \"4 hr, 30 min\".",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "比本地时间快%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "比本地時間快%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカル時刻より%@進んでいます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 시간보다 %@ 빠름"
