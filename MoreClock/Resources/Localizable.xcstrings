    "“%@” is not a time zone. Use an identifier such as “America/Los_Angeles”, an offset such as “UTC+5:30”, or “System”.": {
      "comment": "Shortcuts error. %@ is what the user typed. Keep America/Los_Angeles, UTC+5:30 and the keyword System exactly in English (they are literal inputs the app accepts); localize the quotation marks.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”不是时区。请使用标识符（如“America/Los_Angeles”）、偏移量（如“UTC+5:30”）或“System”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」不是時區。請使用識別碼（例如「America/Los_Angeles」）、偏移量（例如「UTC+5:30」）或「System」。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」は時間帯ではありません。「America/Los_Angeles」などの識別子、「UTC+5:30」などのオフセット、または「System」を使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’은(는) 시간대가 아닙니다. ‘America/Los_Angeles’ 같은 식별자, ‘UTC+5:30’ 같은 오프셋 또는 ‘System’을 사용하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist keine Zeitzone. Verwende eine Kennung wie „America/Los_Angeles“, einen Versatz wie „UTC+5:30“ oder „System“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » n’est pas un fuseau horaire. Utilisez un identifiant tel que « America/Los_Angeles », un décalage tel que « UTC+5:30 » ou « System »."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” no es una zona horaria. Usa un identificador como “America/Los_Angeles”, un desfase como “UTC+5:30” o “System”."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” non è un fuso orario. Usa un identificatore come “America/Los_Angeles”, uno scostamento come “UTC+5:30” o “System”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” não é um fuso horário. Use um identificador como “America/Los_Angeles”, uma diferença como “UTC+5:30” ou “System”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» не является часовым поясом. Используйте идентификатор, например «America/Los_Angeles», смещение, например «UTC+5:30», или «System»."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» ليست منطقة زمنية. استخدم معرّفًا مثل «America/Los_Angeles» أو فارق توقيت مثل «UTC+5:30» أو «System»."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» یک منطقه زمانی نیست. از شناسه‌ای مانند «America/Los_Angeles»، اختلاف ساعتی مانند «UTC+5:30» یا «System» استفاده کنید."
          }
        }
      }
    }
  },
  "version": "1.0"
}
