    "Type a city such as “Tokyo”, a zone such as “Pacific Time”, or an offset such as “UTC+5:30”.": {
      "comment": "Empty-state text. You may localize the example city and the example zone name (use the localized name of Pacific Time as macOS shows it); keep UTC+5:30.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入城市（如“东京”）、时区（如“太平洋时间”）或偏移量（如“UTC+5:30”）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入城市（例如「東京」）、時區（例如「太平洋時間」）或偏移量（例如「UTC+5:30」）。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「東京」などの都市、「アメリカ太平洋時間」などの時間帯、または「UTC+5:30」などのオフセットを入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘서울’ 같은 도시, ‘미 태평양 시간’ 같은 시간대 또는 ‘UTC+5:30’ 같은 오프셋을 입력하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib eine Stadt wie „Tokio“, eine Zone wie „Nordamerikanische Westküstenzeit“ oder einen Versatz wie „UTC+5:30“ ein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez une ville comme « Tokyo », un fuseau comme « heure du Pacifique » ou un décalage comme « UTC+5:30 »."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe una ciudad como “Tokio”, una zona como “hora del Pacífico” o un desfase como “UTC+5:30”."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci una città come “Tokyo”, un fuso come “ora del Pacifico” o uno scostamento come “UTC+5:30”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite uma cidade como “Tóquio”, um fuso como “Horário do Pacífico” ou uma diferença como “UTC+5:30”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите город, например «Токио», пояс, например «Тихоокеанское время», или смещение, например «UTC+5:30»."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب اسم مدينة مثل «طوكيو» أو منطقة مثل «توقيت المحيط الهادي» أو فارق توقيت مثل «UTC+5:30»."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نام شهری مانند «توکیو»، منطقه‌ای مانند «وقت اقیانوس آرام» یا اختلاف ساعتی مانند «UTC+5:30» را تایپ کنید."
          }
        }
      }
    },
