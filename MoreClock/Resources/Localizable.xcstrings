    "Hold ⌘ and drag a clock to move it in the menu bar. Drag it out of the menu bar to hide it.": {
      "comment": "Settings footer; keep the ⌘ symbol.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 ⌘ 并拖动时钟可调整其在菜单栏中的位置。将时钟拖出菜单栏即可隐藏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 ⌘ 並拖移時鐘即可調整其在選單列中的位置。將時鐘拖出選單列即可隱藏。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘キーを押したまま時計をドラッグすると、メニューバー内で移動できます。メニューバーの外へドラッグすると非表示になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘ 키를 누른 채로 시계를 드래그하면 메뉴 막대에서 위치를 옮길 수 있습니다. 메뉴 막대 밖으로 드래그하면 가려집니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte ⌘ gedrückt und ziehe eine Uhr, um sie in der Menüleiste zu verschieben. Ziehe sie aus der Menüleiste, um sie auszublenden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez la touche ⌘ enfoncée et faites glisser une horloge pour la déplacer dans la barre des menus. Faites-la glisser hors de la barre des menus pour la masquer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsada la tecla ⌘ y arrastra un reloj para moverlo en la barra de menús. Arrástralo fuera de la barra de menús para ocultarlo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto ⌘ e trascina un orologio per spostarlo nella barra dei menu. Trascinalo fuori dalla barra dei menu per nasconderlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha ⌘ pressionado e arraste um relógio para movê-lo na barra de menus. Arraste-o para fora da barra de menus para ocultá-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживая ⌘, перетяните часы, чтобы переместить их в строке меню. Перетяните их за пределы строки меню, чтобы скрыть."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مع الاستمرار على ⌘ واسحب ساعة لنقلها في شريط القائمة. اسحبها خارج شريط القائمة لإخفائها."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کلید ⌘ را نگه دارید و ساعت را بکشید تا جای آن را در نوار منو تغییر دهید. برای پنهان کردن، آن را به بیرون از نوار منو بکشید."
          }
        }
      }
    },
