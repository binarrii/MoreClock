    "Allow MoreClock in System Settings › General › Login Items & Extensions.": {
      "comment": "Use Apple's exact localized names for System Settings, General, Login Items & Extensions in your language; keep the › separators.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“系统设置” › “通用” › “登录项与扩展”中允许 MoreClock。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「系統設定」›「一般」›「登入項目與延伸功能」中允許 MoreClock。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定 › 一般 › ログイン項目と機能拡張でMoreClockを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 › 일반 › 로그인 항목 및 확장 프로그램에서 MoreClock을 허용하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube MoreClock unter Systemeinstellungen › Allgemein › Anmeldeobjekte & Erweiterungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez MoreClock dans Réglages Système › Général › Ouverture et extensions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite MoreClock en Ajustes del Sistema › General › Ítems de inicio y extensiones."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti MoreClock in Impostazioni di Sistema › Generali › Elementi login ed estensioni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o MoreClock em Ajustes do Sistema › Geral › Itens de Início e Extensões."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите MoreClock в разделе «Системные настройки» › «Основные» › «Объекты входа и расширения»."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح لتطبيق MoreClock في إعدادات النظام › عام › عناصر تسجيل الدخول والملحقات."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به MoreClock در تنظیمات سیستم › عمومی › موارد ورود و افزونه‌ها اجازه دهید."
          }
        }
      }
    },
